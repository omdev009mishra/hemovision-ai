{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemovision.ai/schemas/images.schema.json",
  "title": "ImageRecord",
  "description": "Schema for individual conjunctival photograph metadata, camera hardware specs, and quality metrics.",
  "type": "object",
  "properties": {
    "image_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$",
      "description": "Unique image record identifier."
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$",
      "description": "Capture session identifier."
    },
    "participant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$",
      "description": "Pseudonymous participant identifier."
    },
    "eye_side": {
      "type": "string",
      "enum": ["left", "right", "unknown"],
      "description": "Which eye is captured in the photograph."
    },
    "frame_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Frame index within multi-frame capture burst."
    },
    "image_path": {
      "type": "string",
      "description": "Relative storage path to image file."
    },
    "capture_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of photo capture."
    },
    "phone_manufacturer": {
      "type": "string",
      "description": "Smartphone manufacturer (e.g. Google, Apple, Samsung)."
    },
    "phone_model": {
      "type": "string",
      "description": "Smartphone model (e.g. Pixel 7 Pro, iPhone 14)."
    },
    "camera_lens_type": {
      "type": "string",
      "enum": ["main_wide", "telephoto", "ultra_wide", "front_facing", "unknown"],
      "description": "Camera lens module utilized."
    },
    "image_width": {
      "type": "integer",
      "minimum": 1,
      "description": "Image width in pixels."
    },
    "image_height": {
      "type": "integer",
      "minimum": 1,
      "description": "Image height in pixels."
    },
    "focus_score": {
      "type": "number",
      "minimum": 0.0,
      "description": "Quantitative image focus metric (e.g. Laplacian variance)."
    },
    "exposure_info": {
      "type": "object",
      "properties": {
        "mean_intensity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 255.0
        },
        "overexposed_pixel_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "underexposed_pixel_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "exposure_status": {
          "type": "string",
          "enum": ["optimal", "overexposed", "underexposed"]
        }
      },
      "required": ["mean_intensity", "exposure_status"],
      "additionalProperties": false
    },
    "image_quality_status": {
      "type": "string",
      "enum": ["usable", "rejected_blur", "rejected_exposure", "rejected_occlusion", "rejected_framing", "pending_review"],
      "description": "Quality assessment decision status."
    },
    "annotation_status": {
      "type": "string",
      "enum": ["unannotated", "in_review", "annotated", "rejected_quality"],
      "description": "Status of segmentation boundary annotation."
    }
  },
  "required": [
    "image_id",
    "session_id",
    "participant_id",
    "eye_side",
    "frame_index",
    "image_path",
    "capture_timestamp",
    "phone_manufacturer",
    "phone_model",
    "camera_lens_type",
    "image_width",
    "image_height",
    "focus_score",
    "exposure_info",
    "image_quality_status",
    "annotation_status"
  ],
  "additionalProperties": false
}
