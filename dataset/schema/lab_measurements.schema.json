{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemovision.ai/schemas/lab_measurements.schema.json",
  "title": "LaboratoryMeasurementRecord",
  "description": "Schema for clinical laboratory reference hemoglobin measurements and complete blood count metrics.",
  "type": "object",
  "properties": {
    "lab_measurement_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$",
      "description": "Unique laboratory reference measurement identifier."
    },
    "participant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$",
      "description": "Pseudonymous participant identifier."
    },
    "measurement_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of reference laboratory blood draw."
    },
    "laboratory_hb_g_dl": {
      "type": "number",
      "minimum": 2.0,
      "maximum": 25.0,
      "description": "Reference laboratory hemoglobin concentration in g/dL."
    },
    "measurement_method": {
      "type": "string",
      "enum": ["venous_automated_hematology", "capillary_microcuvette", "cyanmethemoglobin_reference", "other_validated_method"],
      "description": "Reference laboratory analytical method."
    },
    "instrument_manufacturer": {
      "type": "string",
      "description": "Manufacturer of hematology analyzer / microcuvette system."
    },
    "instrument_model": {
      "type": "string",
      "description": "Model of hematology analyzer / microcuvette system."
    },
    "hematocrit_pct": {
      "type": "number",
      "minimum": 5.0,
      "maximum": 75.0,
      "description": "Hematocrit percentage (if CBC available)."
    },
    "rbc_count_10e6_uL": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 10.0,
      "description": "Red blood cell count in 10^6 / uL (if CBC available)."
    },
    "lab_quality_status": {
      "type": "string",
      "enum": ["valid_verified", "hemolyzed_sample", "clotted_sample", "unverified_flag"],
      "description": "Laboratory sample quality and verification state."
    }
  },
  "required": [
    "lab_measurement_id",
    "participant_id",
    "measurement_timestamp",
    "laboratory_hb_g_dl",
    "measurement_method",
    "instrument_manufacturer",
    "instrument_model",
    "lab_quality_status"
  ],
  "additionalProperties": false
}
