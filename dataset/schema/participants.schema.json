{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemovision.ai/schemas/participants.schema.json",
  "title": "ParticipantRecord",
  "description": "Schema for clinical study participant demographics, baseline physiological state, and confounding factors.",
  "type": "object",
  "properties": {
    "participant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$",
      "description": "Pseudonymous or synthetic participant identifier."
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120,
      "description": "Participant age in completed years."
    },
    "sex": {
      "type": "string",
      "enum": ["male", "female", "intersex", "unknown"],
      "description": "Biological sex assigned at birth."
    },
    "pregnancy_status": {
      "type": "string",
      "enum": ["not_pregnant", "first_trimester", "second_trimester", "third_trimester", "postpartum", "not_applicable", "unknown"],
      "description": "Pregnancy trimester or status."
    },
    "smoking_status": {
      "type": "string",
      "enum": ["non_smoker", "active_smoker", "former_smoker", "unknown"],
      "description": "Tobacco smoking status."
    },
    "skin_tone_fitzpatrick": {
      "type": "string",
      "enum": ["I", "II", "III", "IV", "V", "VI", "unknown"],
      "description": "Fitzpatrick skin phototype scale."
    },
    "ethnicity": {
      "type": "string",
      "description": "Self-reported demographic or geographic background."
    },
    "residence_altitude_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 9000,
      "description": "Approximate altitude of primary residence in meters above sea level."
    },
    "known_comorbidities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of reported co-occurring physiological or ocular conditions."
    }
  },
  "required": [
    "participant_id",
    "age",
    "sex",
    "pregnancy_status",
    "smoking_status"
  ],
  "additionalProperties": false
}
