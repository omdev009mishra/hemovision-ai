{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemovision.ai/schemas/participants.schema.json",
  "title": "ParticipantRecord",
  "description": "Schema for clinical study participant demographics, baseline physiological state, and confounding factors.",
  "type": "object",
  "properties": {
    "participant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$",
      "description": "Pseudonymous participant identifier."
    },
    "age_years": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120,
      "description": "Participant age in completed years."
    },
    "sex": {
      "type": "string",
      "enum": ["male", "female", "intersex", "unknown"],
      "description": "Biological sex assigned at birth."
    },
    "pregnancy_status": {
      "type": "string",
      "enum": ["not_pregnant", "first_trimester", "second_trimester", "third_trimester", "postpartum", "not_applicable", "unknown"],
      "description": "Pregnancy status or trimester."
    },
    "smoking_status": {
      "type": "string",
      "enum": ["never", "active_smoker", "former_smoker", "unknown"],
      "description": "Tobacco smoking status."
    },
    "skin_phototype": {
      "type": "string",
      "enum": ["I", "II", "III", "IV", "V", "VI", "unknown"],
      "description": "Fitzpatrick skin phototype scale."
    },
    "residence_altitude_m": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 9000.0,
      "description": "Approximate altitude of primary residence in meters."
    },
    "relevant_comorbidities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of reported co-occurring physiological conditions."
    },
    "relevant_ocular_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of reported ocular conditions (e.g., pinguecula, pterygium, conjunctivitis)."
    }
  },
  "required": [
    "participant_id",
    "age_years",
    "sex",
    "pregnancy_status",
    "smoking_status"
  ],
  "additionalProperties": false
}
